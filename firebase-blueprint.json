{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique Firebase Auth UID" },
        "name": { "type": "string", "description": "Display name", "maxLength": 100 },
        "email": { "type": "string", "description": "User email address", "maxLength": 120 },
        "avatar": { "type": "string", "description": "Avatar initials or image URL", "maxLength": 255 },
        "phoneNumber": { "type": "string", "description": "Optional phone number", "maxLength": 30 },
        "role": { "type": "string", "description": "App role", "enum": ["admin", "user"] },
        "plan": { "type": "string", "description": "Current subscription tier", "maxLength": 50 },
        "createdAt": { "type": "string", "description": "Account creation ISO timestamp" }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "Group": {
      "title": "Group",
      "description": "Alarm coordination group such as Fellowship, Barkada, Family, Team",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Group ID" },
        "name": { "type": "string", "description": "Group name", "maxLength": 100 },
        "description": { "type": "string", "description": "Short description of the group", "maxLength": 300 },
        "ownerId": { "type": "string", "description": "UID of group creator/owner" },
        "avatarInitials": { "type": "string", "description": "Two letter badge", "maxLength": 5 },
        "inviteCode": { "type": "string", "description": "6 character code for joining", "maxLength": 10 },
        "memberCount": { "type": "number", "description": "Cached count of members" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "name", "ownerId", "inviteCode", "createdAt"]
    },
    "GroupMember": {
      "title": "GroupMember",
      "description": "Membership document within a group",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "name": { "type": "string", "description": "Member display name", "maxLength": 100 },
        "email": { "type": "string", "description": "Member email", "maxLength": 120 },
        "role": { "type": "string", "description": "Member role", "enum": ["owner", "admin", "member"] },
        "joinedAt": { "type": "string", "description": "Timestamp joined" }
      },
      "required": ["userId", "name", "role", "joinedAt"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Alarm schedule or event inside a group",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Schedule unique ID" },
        "groupId": { "type": "string", "description": "Parent group ID" },
        "title": { "type": "string", "description": "Title of the alarm/event", "maxLength": 120 },
        "location": { "type": "string", "description": "Venue or location name", "maxLength": 150 },
        "description": { "type": "string", "description": "Event instructions or notes", "maxLength": 500 },
        "scheduleType": { "type": "string", "description": "Type of event recurrence", "enum": ["single", "range", "recurring"] },
        "startDate": { "type": "string", "description": "Start date YYYY-MM-DD", "maxLength": 30 },
        "endDate": { "type": "string", "description": "End date YYYY-MM-DD", "maxLength": 30 },
        "startTime": { "type": "string", "description": "Start time HH:MM or label", "maxLength": 20 },
        "reminderMinutes": { "type": "number", "description": "Minutes before event to trigger alarm" },
        "criticalAlert": { "type": "boolean", "description": "Whether alarm rings through silent mode" },
        "creatorId": { "type": "string", "description": "UID of creator" },
        "creatorName": { "type": "string", "description": "Name of creator", "maxLength": 100 },
        "status": { "type": "string", "description": "Current schedule status", "enum": ["upcoming", "active", "completed", "cancelled"] },
        "alarmSoundType": { "type": "string", "description": "Selected sound theme or custom", "maxLength": 50 },
        "customSoundName": { "type": "string", "description": "Filename of uploaded custom audio", "maxLength": 100 },
        "customSoundData": { "type": "string", "description": "Data URI of uploaded audio sound" },
        "activeAlarmTimestamp": { "type": "number", "description": "Epoch timestamp of actively ringing broadcast alarm, 0 if idle" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "groupId", "title", "scheduleType", "startDate", "startTime", "creatorId", "createdAt"]
    },
    "Acknowledgement": {
      "title": "Acknowledgement",
      "description": "Member RSVP response to an alarm or schedule",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID" },
        "userName": { "type": "string", "description": "Display name of member", "maxLength": 100 },
        "status": { "type": "string", "description": "Response status", "enum": ["coming", "dismissed", "pending"] },
        "reason": { "type": "string", "description": "Optional reason for dismissing", "maxLength": 300 },
        "acknowledgedAt": { "type": "string", "description": "Timestamp of response" }
      },
      "required": ["userId", "userName", "status", "acknowledgedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Group document"
    },
    "/groups/{groupId}/members/{userId}": {
      "schema": "GroupMember",
      "description": "Members belonging to a group"
    },
    "/groups/{groupId}/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Schedules and alarms for the group"
    },
    "/groups/{groupId}/schedules/{scheduleId}/acknowledgements/{userId}": {
      "schema": "Acknowledgement",
      "description": "Member RSVPs and alarm acknowledgements"
    }
  }
}
